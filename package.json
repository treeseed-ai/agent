{
  "name": "@treeseed-cordis/agent",
  "version": "0.0.0-cordis.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "check:test-layout": "bun .agents/skills/release-workflow/scripts/test-layout.ts",
    "check": "bun run check:readability && bun run check:test-layout && bun scripts/tooling.ts check",
    "build": "bun scripts/tooling.ts build",
    "test:acceptance": "bun test ./tests/acceptance --pass-with-no-tests",
    "test:regression": "bun test ./tests/regression --pass-with-no-tests",
    "test:integration": "bun test ./tests/integration --pass-with-no-tests",
    "test:unit": "bun test ./tests/unit --pass-with-no-tests",
    "verify": "bun tests/support/empty-tiers.ts && bun run check && bun run build && bun run test:acceptance && bun run test:regression && bun run test:integration && bun run test:unit",
    "check:readability": "bun .agents/skills/release-workflow/scripts/source-readability.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz"
  },
  "description": "Independent Agent development build; runtime composition is delivered in subsequent owner slices.",
  "cordisCandidate": {
    "sdk": {
      "repository": "https://github.com/treeseed-ai/sdk.git",
      "commit": "7eb60a4a68ca770f896e07d0e3d8d2324154e6e9",
      "sha256": "ee30dbacf0e95d3fd9f88d097b15332c3dbf8020c3313c90e0a0578937a5d1df"
    }
  }
}
