{
  "name": "@treeseed/agent",
  "version": "0.12.59-dev.staging.20260716T154316Z",
  "description": "Treeseed agent service runtime package.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treeseed-ai/agent.git",
    "directory": "."
  },
  "homepage": "https://treeseed.ai",
  "bugs": {
    "url": "https://github.com/treeseed-ai/agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./api/app": {
      "types": "./dist/api/app.d.ts",
      "default": "./dist/api/app.js"
    },
    "./api/auth/d1-provider": {
      "types": "./dist/api/auth/d1-provider.d.ts",
      "default": "./dist/api/auth/d1-provider.js"
    },
    "./runtime-types": {
      "types": "./dist/agents/runtime-types.d.ts",
      "default": "./dist/agents/runtime-types.js"
    },
    "./cli": {
      "types": "./dist/agents/cli.d.ts",
      "default": "./dist/agents/cli.js"
    },
    "./contracts/messages": {
      "types": "./dist/agents/contracts/messages.d.ts",
      "default": "./dist/agents/contracts/messages.js"
    },
    "./contracts/run": {
      "types": "./dist/agents/contracts/run.d.ts",
      "default": "./dist/agents/contracts/run.js"
    },
    "./provider-governance": {
      "types": "./dist/provider-governance.d.ts",
      "default": "./dist/provider-governance.js"
    },
    "./provider-acceptance": {
      "types": "./dist/provider-acceptance.d.ts",
      "default": "./dist/provider-acceptance.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "Dockerfile",
    "docker-entrypoint.sh",
    "compose.capacity-provider.yml",
    "treeseed.package.yaml",
    "docs",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "npm install",
    "setup:ci": "npm ci",
    "build": "npm run build:dist",
    "build:dist": "node --import tsx ./scripts/build-dist.ts",
    "capacity-provider:build": "node --import tsx ./scripts/build-capacity-provider-container.ts",
    "capacity-provider:test-local": "node ./dist/scripts/test-capacity-provider-container.js",
    "capacity-provider:test-local-live-tools": "TREESEED_AGENT_LIVE_TOOLS=1 node ./dist/scripts/test-capacity-provider-live-tools.js",
    "prepare": "node --import tsx ./scripts/prepare.ts",
    "lint": "npm run build:dist",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run --config ./vitest.config.ts",
    "test:agent-tools": "vitest run --config ./vitest.config.ts test/agents/agent-tool-*.test.ts test/provider/agent-tool-provider-runtime.test.ts",
    "test:agent-tools:live": "node --import tsx ./scripts/test-agent-tools-live.ts",
    "test:agent-tools:live-copilot": "node --import tsx ./scripts/test-agent-tools-live-copilot.ts",
    "test:capacity-provider-live-codex": "TREESEED_AGENT_LIVE_CODEX=1 node --import tsx ./scripts/test-agent-tools-live.ts",
    "test:human-machine-providers": "npm --workspace @treeseed/sdk run build:dist && vitest run --config ./vitest.config.ts test/agents/execution-provider-contract.test.ts test/agents/codex-provider.test.ts test/agents/jira-provider.test.ts test/agents/github-issues-provider.test.ts test/agents/discord-provider.test.ts test/agents/workflow-provider.test.ts test/provider/assignment-runtime.test.ts && npm run build:dist && npm run capacity-provider:test-local",
    "prepack": "npm run build:dist",
    "test:smoke": "node --import tsx ./scripts/test-smoke.ts",
    "verify:direct": "npm run release:verify",
    "verify:local": "TREESEED_VERIFY_DRIVER=direct TMPDIR=/tmp node --import tsx ./scripts/verify-driver.ts",
    "verify:action": "TREESEED_VERIFY_DRIVER=act TMPDIR=/tmp node --import tsx ./scripts/verify-driver.ts",
    "verify": "TMPDIR=/tmp node --import tsx ./scripts/verify-driver.ts",
    "release:setup": "npm run setup:ci",
    "release:check-tag": "node --import tsx ./scripts/assert-release-tag-version.ts",
    "release:verify": "node --import tsx ./scripts/release-verify.ts",
    "release:publish": "node --import tsx ./scripts/publish-package.ts",
    "test:agent-contracts": "vitest run --config ./vitest.config.ts test/agents/agent-contracts.test.ts test/agents/agent-test-catalog.test.ts test/agents/starter-contracts.test.ts",
    "test:agent-handlers": "vitest run --config ./vitest.config.ts test/agents/agent-contracts.test.ts test/agents/agent-test-catalog.test.ts",
    "test:agent-message-chains": "vitest run --config ./vitest.config.ts test/agents/message-chain.test.ts",
    "test:provider-runtime": "vitest run --config ./vitest.config.ts test/provider/assignment-runtime.test.ts test/provider/multi-team-coordinator.test.ts",
    "test:capacity-provider-runtime": "vitest run --config ./vitest.config.ts test/provider/assignment-runtime.test.ts test/provider/availability-projection.test.ts test/provider/connection-scheduler.test.ts test/provider/lease-recovery.test.ts test/provider/local-capacity-store.test.ts test/provider/manager-session-recovery.test.ts test/provider/multi-team-coordinator.test.ts test/provider/multi-team-runtime.test.ts test/provider/multi-team-service.test.ts test/provider/provider-architecture.test.ts",
    "test:market-docs-governed-mutation": "vitest run --config ./vitest.config.ts test/agents/codex-provider.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.130.0",
    "@treeseed/sdk": "github:treeseed-ai/sdk#0e1e1f90fd9a4da3c33cf4397ca9dc6d43c00607",
    "esbuild": "0.28.0",
    "hono": "^4.8.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "bin": {
    "treeseed-agents": "dist/scripts/treeseed-agents.js"
  }
}
