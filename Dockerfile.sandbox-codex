ARG SANDBOX_BASE
FROM ${SANDBOX_BASE}
ARG SANDBOX_BASE

USER root
COPY --chown=65532:65532 .treeseed/docker/runtime/shared/package.json .treeseed/docker/runtime/shared/package-lock.json /app/
COPY --chown=65532:65532 .treeseed/docker/runtime/shared/node_modules /app/node_modules
RUN test -x /app/node_modules/@openai/codex/bin/codex.js \
	&& ln -s /app/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
	&& CODE_MODE_HOST="$(find /app/node_modules/@openai -type f -path '*/bin/codex-code-mode-host' -print -quit)" \
	&& test -n "$CODE_MODE_HOST" \
	&& test -x "$CODE_MODE_HOST" \
	&& ln -s "$CODE_MODE_HOST" /usr/local/bin/codex-code-mode-host
LABEL org.opencontainers.image.title="TreeSeed Codex Sandbox" \
	io.treeseed.sandbox.kind="execution-provider" \
	io.treeseed.sandbox.provider="codex" \
	io.treeseed.sandbox.base="${SANDBOX_BASE}"
USER treeseed
