      "types": "./dist/api/auth/d1-provider.d.ts",
      "default": "./dist/api/auth/d1-provider.js"
    },
    "./services/worker": {
      "types": "./dist/services/worker.d.ts",
      "default": "./dist/services/worker.js"
    },
    "./services/manager": {
      "types": "./dist/services/manager.d.ts",
      "default": "./dist/services/manager.js"
    },
    "./services/agents": {
      "types": "./dist/services/agents.d.ts",
      "default": "./dist/services/agents.js"
    },
    "./services/remote-runner": {
      "types": "./dist/services/remote-runner.d.ts",
      "default": "./dist/services/remote-runner.js"
    },
    "./services/workday-manager": {
      "types": "./dist/services/workday-manager.d.ts",
      "default": "./dist/services/workday-manager.js"
    },
    "./services/workday-start": {
      "types": "./dist/services/workday-start.d.ts",
      "default": "./dist/services/workday-start.js"
    },
    "./services/workday-report": {
      "types": "./dist/services/workday-report.d.ts",
      "default": "./dist/services/workday-report.js"
    },
    "./services/runtime-readiness": {
      "types": "./dist/services/runtime-readiness.d.ts",
      "default": "./dist/services/runtime-readiness.js"
    },
    "./runtime-types": {
      "types": "./dist/agents/runtime-types.d.ts",
      "default": "./dist/agents/runtime-types.js"
    },
    "./cli": {
      "types": "./dist/agents/cli.d.ts",
      "default": "./dist/agents/cli.js"
    },
    "./contracts/messages": {
      "types": "./dist/agents/contracts/messages.d.ts",
      "default": "./dist/agents/contracts/messages.js"
    },
    "./contracts/run": {
      "types": "./dist/agents/contracts/run.d.ts",
      "default": "./dist/agents/contracts/run.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "Dockerfile",
    "docker-entrypoint.sh",
    "compose.capacity-provider.yml",
    "treeseed.package.yaml",
    "docs",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "npm install",
    "setup:ci": "npm ci",
    "build": "npm run build:dist",
    "build:dist": "node ./scripts/run-ts.mjs ./scripts/build-dist.ts",
    "capacity-provider:build": "node ./scripts/run-ts.mjs ./scripts/build-capacity-provider-container.ts",
    "capacity-provider:test-local": "node ./dist/scripts/test-capacity-provider-container.js",
    "prepare": "node ./scripts/prepare.mjs",
    "dev:manager": "node ./scripts/run-ts.mjs ./src/services/manager.ts",
    "dev:worker": "node ./scripts/run-ts.mjs ./src/services/worker.ts",
    "dev:workday-start": "node ./scripts/run-ts.mjs ./src/services/workday-start.ts",
    "dev:workday-report": "node ./scripts/run-ts.mjs ./src/services/workday-report.ts",
    "runtime:readiness": "node ./scripts/run-ts.mjs ./scripts/runtime-readiness.ts",
    "dev:remote-runner": "node ./scripts/run-ts.mjs ./src/services/remote-runner.ts",
    "start:manager": "node ./dist/services/manager.js",
    "start:worker": "node ./dist/services/worker.js",
    "start:workday-start": "node ./dist/services/workday-start.js",
    "start:workday-report": "node ./dist/services/workday-report.js",
    "start:runtime-readiness": "node ./dist/scripts/runtime-readiness.js",
    "start:local-manager-cloudflare": "bash ./scripts/run-local-manager-cloudflare.sh",
    "lint": "npm run build:dist",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run --config ./vitest.config.ts",
    "test:market-knowledge-dogfood": "node ./scripts/run-ts.mjs ./scripts/test-market-knowledge-dogfood.ts",
    "test:study-knowledge-packs": "node ./scripts/run-ts.mjs ./scripts/run-study-knowledge-pack-scenario.ts",
    "test:capacity-scheduling-e2e": "node ./scripts/run-ts.mjs ./scripts/test-capacity-scheduling-e2e.ts",
    "test:local-e2e-verification": "node ./scripts/run-ts.mjs ./scripts/test-local-e2e-verification.ts",
    "prepack": "npm run build:dist",
    "test:smoke": "node ./scripts/run-ts.mjs ./scripts/test-smoke.ts",
    "verify:direct": "npm run release:verify",
    "verify:local": "TREESEED_VERIFY_DRIVER=direct node ./scripts/verify-driver.mjs",
    "verify:action": "TREESEED_VERIFY_DRIVER=act node ./scripts/verify-driver.mjs",
    "verify": "node ./scripts/verify-driver.mjs",
    "release:setup": "npm run setup:ci",
    "release:check-tag": "node ./scripts/run-ts.mjs ./scripts/assert-release-tag-version.ts",
    "release:verify": "node ./scripts/run-ts.mjs ./scripts/release-verify.ts",
    "release:publish": "node ./scripts/run-ts.mjs ./scripts/publish-package.ts",
    "test:agent-contracts": "vitest run --config ./vitest.config.ts test/agents/agent-contracts.test.ts test/agents/agent-test-catalog.test.ts",
    "test:agent-handlers": "vitest run --config ./vitest.config.ts test/agents/handler-fixtures.test.ts test/agents/knowledge-handlers.test.ts",
    "test:agent-message-chains": "vitest run --config ./vitest.config.ts test/agents/message-chain.test.ts test/services/research-knowledge-workday.test.ts",
    "test:manager-worker": "vitest run --config ./vitest.config.ts test/services/manager.test.ts test/services/worker.test.ts test/services/manager-worker-parity-report.test.ts",
    "test:capacity-provider-runtime": "vitest run --config ./vitest.config.ts test/provider/capacity-provider-runtime.test.ts",
    "test:market-docs-governed-mutation": "vitest run --config ./vitest.config.ts test/agents/local-e2e-verification.test.ts && npm run test:local-e2e-verification"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.130.0",
    "@treeseed/sdk": "github:treeseed-ai/sdk#0.11.1-dev.demo.20260618T214811Z",
    "esbuild": "0.28.0",
    "hono": "^4.8.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "vitest": "^4.1.2"
  },
  "bin": {
    "treeseed-agents": "dist/scripts/treeseed-agents.js",
    "treeseed-agent-api": "dist/scripts/treeseed-agent-api.js",
    "treeseed-agent-service": "dist/scripts/treeseed-agent-service.js"
  }
}
