# Copy to .env.local-manager-cloudflare and fill in real values.

# Repo and local D1 context
TREESEED_AGENT_REPO_ROOT=/absolute/path/to/your/site
TREESEED_AGENT_D1_DATABASE=treeseed-local
TREESEED_AGENT_D1_PERSIST_TO=.wrangler/state/v3/d1

# Manager HTTP server
HOST=127.0.0.1
PORT=3100
TREESEED_PROJECT_ID=treeseed-market
TREESEED_WORKDAY_TASK_CREDIT_BUDGET=100

# Cloudflare gateway used for durable task/workday writes
TREESEED_GATEWAY_BASE_URL=https://treeseed-agent-gateway.<your-subdomain>.workers.dev
TREESEED_GATEWAY_BEARER_TOKEN=replace-with-gateway-bearer-token

# Optional local worker support against Cloudflare Queue
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
TREESEED_QUEUE_ID=replace-with-cloudflare-queue-id
TREESEED_QUEUE_PULL_TOKEN=replace-with-queue-pull-token
TREESEED_QUEUE_BATCH_SIZE=1
TREESEED_QUEUE_VISIBILITY_TIMEOUT_MS=120000
TREESEED_TASK_LEASE_SECONDS=120
TREESEED_WORKER_POLL_INTERVAL_MS=5000

# Optional worker -> manager service URL override
TREESEED_MANAGER_BASE_URL=http://127.0.0.1:3100
