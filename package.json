{
  "name": "@treeseed/agent",
  "version": "0.13.0-rc.20",
  "description": "Treeseed agent service runtime package.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/treeseed-ai/agent.git",
    "directory": "."
  },
  "homepage": "https://treeseed.ai",
  "bugs": {
    "url": "https://github.com/treeseed-ai/agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider-governance": {
      "types": "./dist/provider-governance.d.ts",
      "default": "./dist/provider-governance.js"
    },
    "./executors/codex-chat": {
      "types": "./dist/provider/execution/codex-chat-executor.d.ts",
      "default": "./dist/provider/execution/codex-chat-executor.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "Dockerfile",
    "docker-entrypoint.sh",
    "compose.capacity-provider.yml",
    "treeseed.package.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "npm install",
    "setup:ci": "npm ci",
    "build": "npm run build:dist",
    "build:dist": "node --import tsx ./scripts/build/build-dist.ts",
    "check:file-lengths": "node --import tsx ./scripts/support/check-file-lengths.ts && npm run check:file-architecture",
    "check:file-architecture": "node --import tsx ./scripts/support/check-file-architecture.ts",
    "capacity-provider:build": "node --import tsx ./scripts/capacity/providers/build-capacity-provider-container.ts",
    "prepare": "node --import tsx ./scripts/support/prepare.ts",
    "lint": "npm run check:file-lengths && npm run build:dist",
    "test": "npm run test:modern",
    "test:modern": "vitest run --config ./vitest.config.ts",
    "prepack": "npm run build:dist",
    "verify:direct": "npm run release:verify",
    "verify:local": "TREESEED_VERIFY_DRIVER=direct TMPDIR=/tmp node --import tsx ./scripts/support/verify-driver.ts",
    "verify:action": "TREESEED_VERIFY_DRIVER=act TMPDIR=/tmp node --import tsx ./scripts/support/verify-driver.ts",
    "verify": "TMPDIR=/tmp node --import tsx ./scripts/support/verify-driver.ts",
    "release:setup": "npm run setup:ci",
    "release:check-tag": "node --import tsx ./scripts/packages/assert-release-tag-version.ts",
    "release:verify": "npm run check:file-lengths && node --import tsx ./scripts/packages/release-verify.ts",
    "release:publish": "node --import tsx ./scripts/packages/publish-package.ts",
    "test:provider-runtime": "npm run test:modern"
  },
  "dependencies": {
    "@openai/codex": "0.149.0",
    "@treeseed/sdk": "0.13.0-rc.38",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  }
}
